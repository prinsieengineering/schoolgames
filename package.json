{
  "name": "schoolgames",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:deel": "tsc -b && vite build --mode deel && node -e \"require('fs').renameSync('deel/index.html','deel/Schoolgames.html')\"",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name schoolgames --branch main",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dicebear/core": "^11.0.0",
    "@dicebear/styles": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
